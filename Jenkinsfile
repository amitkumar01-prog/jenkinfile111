pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub integration successful'
            }
        }

        stage('Build') {
            steps {
                echo 'Building project'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing project'
            }
        }

        stage('Finish') {
            steps {
                echo 'Assignment completed!'
            }
        }
    }
}